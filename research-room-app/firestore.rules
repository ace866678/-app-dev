rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Research workspaces - members can read, owners can write
    match /research_workspaces/{workspaceId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/research_members/$(request.auth.uid)) &&
        resource.data.members.hasAny([request.auth.uid]);
      
      allow create: if request.auth != null && 
        request.resource.data.ownerId == request.auth.uid;
      
      allow update, delete: if request.auth != null && 
        resource.data.ownerId == request.auth.uid;
    }

    // Research members - users can read their own memberships
    match /research_members/{memberId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || 
         exists(/databases/$(database)/documents/research_workspaces/$(resource.data.workspaceId)/ownerId) &&
         resource.data.workspaceId in get(/databases/$(database)/documents/research_workspaces/$(resource.data.workspaceId)).data.members);
      
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }

    // Research messages - workspace members can read/write
    match /research_messages/{messageId} {
      allow read: if request.auth != null && 
        resource.data.workspaceId in get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.workspaceIds;
      
      allow create: if request.auth != null && 
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.workspaceId in get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.workspaceIds;
    }

    // Research sections - workspace members can read, owners/editors can write
    match /research_sections/{sectionId} {
      allow read: if request.auth != null && 
        resource.data.workspaceId in get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.workspaceIds;
      
      allow create, update: if request.auth != null && 
        request.resource.data.workspaceId in get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.workspaceIds &&
        (resource.data.ownerId == request.auth.uid || 
         get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.role in ['owner', 'editor']);
      
      allow delete: if request.auth != null && 
        resource.data.ownerId == request.auth.uid;
    }

    // Research tasks - workspace members can read, assignee/owner can write
    match /research_tasks/{taskId} {
      allow read: if request.auth != null && 
        resource.data.workspaceId in get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.workspaceIds;
      
      allow create, update: if request.auth != null && 
        request.resource.data.workspaceId in get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.workspaceIds;
      
      allow delete: if request.auth != null && 
        (resource.data.assigneeId == request.auth.uid || 
         resource.data.workspaceId in get(/databases/$(database)/documents/research_workspaces/$(resource.data.workspaceId)).data.ownerId);
    }

    // Research meetings - workspace members can read, owner can write
    match /research_meetings/{meetingId} {
      allow read: if request.auth != null && 
        resource.data.workspaceId in get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.workspaceIds;
      
      allow create, update, delete: if request.auth != null && 
        resource.data.workspaceId in get(/databases/$(database)/documents/research_workspaces/$(resource.data.workspaceId)).data.ownerId;
    }

    // Research chapters - workspace members can read, owners/editors can write
    match /research_chapters/{chapterId} {
      allow read: if request.auth != null && 
        resource.data.workspaceId in get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.workspaceIds;
      
      allow create, update: if request.auth != null && 
        request.resource.data.workspaceId in get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.workspaceIds &&
        (resource.data.ownerId == request.auth.uid || 
         get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.role in ['owner', 'editor']);
      
      allow delete: if request.auth != null && 
        resource.data.ownerId == request.auth.uid;
    }

    // Research notifications - recipient can read/update
    match /research_notifications/{notificationId} {
      allow read, update: if request.auth != null && 
        resource.data.recipientId == request.auth.uid;
    }

    // Research member profiles - workspace members can read, user can update own
    match /research_member_profiles/{profileId} {
      allow read: if request.auth != null && 
        resource.data.workspaceId in get(/databases/$(database)/documents/research_members/$(request.auth.uid)).data.workspaceIds;
      
      allow create, update: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }
  }
}