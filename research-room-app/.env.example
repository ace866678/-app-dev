# Copy to .env.local and replace with values from Firebase Console > Project settings > General > Your apps.
VITE_FIREBASE_API_KEY=replace-with-web-app-api-key
VITE_FIREBASE_AUTH_DOMAIN=researchroom-71e70.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=researchroom-71e70
VITE_FIREBASE_STORAGE_BUCKET=researchroom-71e70.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-app-id

# Optional local emulator setting. Start the Auth/Firestore emulators before enabling.
# VITE_USE_FIREBASE_EMULATORS=true
